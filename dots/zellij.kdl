// zellij — minimal config: deltas over v0.45 defaults
// Wired via home/dotfiles.nix → ~/.config/zellij/config.kdl
// (first switch renames a pre-existing live config to config.kdl.hm-bak)

// match WezTerm (Catppuccin Mocha)
theme "catppuccin-mocha"

// clean chrome
pane_frames false
default_layout "compact"
show_startup_tips false
show_release_notes false

// macOS clipboard + mouse
copy_command "pbcopy"
copy_on_select true
mouse_mode true

// passthrough-first UX (single letters still switch modes)
default_mode "locked"

// tmux muscle memory — mirrors dots/.tmux.conf: prefix `, base-index 1.
// Zellij has no key sequences; the prefix is a mode hop: ` enters tab mode,
// whose keys act once and return to locked. Scoped to locked so normal-mode
// typing is untouched; tmux grabs the backtick itself when nested in a pane.
keybinds {
    locked {
        bind "`" { SwitchToMode "tab"; }
    }
    tab {
        bind "1" { GoToTab 1; SwitchToMode "locked"; }
        bind "2" { GoToTab 2; SwitchToMode "locked"; }
        bind "3" { GoToTab 3; SwitchToMode "locked"; }
        bind "4" { GoToTab 4; SwitchToMode "locked"; }
        bind "5" { GoToTab 5; SwitchToMode "locked"; }
        bind "6" { GoToTab 6; SwitchToMode "locked"; }
        bind "7" { GoToTab 7; SwitchToMode "locked"; }
        bind "8" { GoToTab 8; SwitchToMode "locked"; }
        bind "9" { GoToTab 9; SwitchToMode "locked"; }
        bind "`" { WriteChars "`"; SwitchToMode "locked"; } // literal backtick (= tmux send-prefix)
        bind "c" { NewTab; SwitchToMode "locked"; }
        bind "n" { GoToNextTab; SwitchToMode "locked"; }
        bind "p" { GoToPreviousTab; SwitchToMode "locked"; }
        bind "d" { Detach; }
    }
}
